# Copy this file to .env and adjust values for your environment.
# docker-compose.yml and application.yml both read these with safe local-dev
# defaults, so none of this is required to run `docker compose up -d` locally.

# --- docker-compose (infra) ---
POSTGRES_DB=riseflow
POSTGRES_USER=riseflow
POSTGRES_PASSWORD=riseflow
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# --- riseflow-api (application) ---
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/riseflow
SPRING_DATASOURCE_USERNAME=riseflow
SPRING_DATASOURCE_PASSWORD=riseflow
SPRING_SECURITY_OAUTH2_RESOURCESERVER_JWT_ISSUER_URI=http://localhost:8081/realms/riseflow
RISEFLOW_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
