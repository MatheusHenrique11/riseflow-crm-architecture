{
  "realm": "riseflow",
  "enabled": true,
  "clientScopes": [
    { "name": "account:read", "protocol": "openid-connect" },
    { "name": "account:write", "protocol": "openid-connect" },
    { "name": "commission:read", "protocol": "openid-connect" },
    { "name": "commission:write", "protocol": "openid-connect" },
    { "name": "custom-field:read", "protocol": "openid-connect" },
    { "name": "custom-field:write", "protocol": "openid-connect" },
    { "name": "deal:read", "protocol": "openid-connect" },
    { "name": "deal:write", "protocol": "openid-connect" },
    { "name": "invoice:read", "protocol": "openid-connect" },
    { "name": "invoice:write", "protocol": "openid-connect" },
    { "name": "marketing:read", "protocol": "openid-connect" },
    { "name": "marketing:write", "protocol": "openid-connect" },
    { "name": "pipeline:read", "protocol": "openid-connect" },
    { "name": "pipeline:write", "protocol": "openid-connect" },
    { "name": "proposal:read", "protocol": "openid-connect" },
    { "name": "proposal:write", "protocol": "openid-connect" },
    { "name": "tenant:read", "protocol": "openid-connect" },
    { "name": "tenant:write", "protocol": "openid-connect" }
  ],
  "clients": [
    {
      "clientId": "riseflow-api",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "riseflow-secret",
      "serviceAccountsEnabled": true,
      "directAccessGrantsEnabled": true,
      "redirectUris": ["http://localhost:8080/*"],
      "defaultClientScopes": [
        "account:read", "account:write",
        "commission:read", "commission:write",
        "custom-field:read", "custom-field:write",
        "deal:read", "deal:write",
        "invoice:read", "invoice:write",
        "marketing:read", "marketing:write",
        "pipeline:read", "pipeline:write",
        "proposal:read", "proposal:write",
        "tenant:read", "tenant:write"
      ],
      "protocolMappers": [
        {
          "name": "tenant_id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "config": {
            "claim.name": "tenant_id",
            "claim.value": "00000000-0000-0000-0000-000000000001",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "true"
          }
        }
      ]
    }
  ]
}
